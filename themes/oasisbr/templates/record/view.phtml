<?php
// Disable top search box on record/item pages.
$this->layout()->searchbox = false;

// Set up standard record scripts:
$this->assetManager()->appendScriptLink("record.js");
$this->assetManager()->appendScriptLink("check_save_statuses.js");
$this->assetManager()->appendScriptLink("record-details-toggle.js");
// Activate Syndetics Plus if necessary:
// if ($this->syndeticsPlus()->isActive()) {
//   $this->headScript()->appendFile($this->syndeticsPlus()->getScript());
// }
// Add any extra scripts the tabs require:
foreach ($this->tabsExtraScripts as $script) {
  $this->assetManager()->appendScriptLink($script);
}

// Add RDF header link if applicable:
if ($this->export()->recordSupportsFormat($this->driver, 'RDF')) {
  $this->assetManager()->appendLinkTag('alternate', $this->recordLinker()->getActionUrl($this->driver, 'RDF'), 'application/rdf+xml', 'RDF Representation');
}

// Set up breadcrumbs:
$activeTabDescription = null;
foreach ($this->tabs as $tab => $obj) {
  if (0 === strcasecmp($this->activeTab, $tab)) {
    $activeTabDescription = $obj->getDescription();
    break;
  }
}
$activeBreadcrumb = 0 === strcasecmp($this->activeTab, 'Details')
  ? 'Metadados do item'
  : $this->translate($activeTabDescription ?? 'Metadados do item');
$this->breadcrumbs()->reset();
if ($url = $this->searchMemory()->getLastSearchUrl()) {
  $this->breadcrumbs()->add($this->translate('Search'), $url);
}
$this->breadcrumbs()->add(...$this->recordLinker()->getBreadcrumbParams($this->driver))
  ->add($activeBreadcrumb, active: true);
$this->layout()->title = $this->driver->getShortTitle();
?>

<?php if (isset($this->scrollData) && ($this->scrollData['previousRecord'] || $this->scrollData['nextRecord'])) : ?>
  <?= $this->render('record/prev-next.phtml'); ?>
<?php endif; ?>

<?= $this->record($this->driver)->getToolbar() ?>

<div class="record source<?= $this->escapeHtmlAttr($this->driver->getSourceIdentifier()) ?>">
  <?php $sidebarList = $this->related()->getList($this->driver); ?>
  <?php $this->layout()->oasisRelatedRecords = $sidebarList; ?>
  <div class="<?= $this->layoutClass('mainbody') ?> solo oasis-record-mainbody">
    <input type="hidden" value="<?= $this->escapeHtmlAttr($this->driver->getUniqueId()) ?>" class="hiddenId" />
    <input type="hidden" value="<?= $this->escapeHtmlAttr($this->driver->getSourceIdentifier()) ?>" class="hiddenSource" />
    <?= $this->flashmessages() ?>

    <?php ob_start(); ?>
    <?php if (count($this->tabs) > 0) : ?>
      <a name="tabnav"></a>
      <div class="record-tabs">
        <ul class="nav nav-tabs">
          <?php foreach ($this->tabs as $tab => $obj) : ?>
            <?php // add current tab to breadcrumbs if applicable:
            $desc = $obj->getDescription();
            $tabName = preg_replace("/\W/", "-", strtolower($tab));
            $tabClasses = ['record-tab', $tabName];
            if (0 === strcasecmp($this->activeTab, $tab)) {
              if (!$this->loadInitialTabWithAjax || !$obj->supportsAjax()) {
                // $tabClasses[] = 'active';
              }
              // $tabClasses[] = 'initiallyActive';
              $activeTabObj = $obj;
            }
            if (!$obj->isVisible()) {
              $tabClasses[] = 'hidden';
            }
            if (!$obj->supportsAjax()) {
              $tabClasses[] = 'noajax';
            }
            ?>
            <li class="<?= implode(' ', $tabClasses) ?>" data-tab="<?= $tabName ?>" <?php if ($obj->supportsAjax() && in_array($tab, $this->backgroundTabs)) : ?> data-background<?php endif ?>>
              <a class="<?= $tabName === 'details' ? 'oasis-record-details-toggle' : '' ?>" href="<?= $this->recordLinker()->getTabUrl($this->driver, $tab) ?>#tabnav" data-lightbox-ignore<?php if ($tabName === 'details') : ?> aria-controls="record-tab-panel-details" aria-expanded="false"<?php endif; ?>>
                <?= $this->transEsc($desc) ?>
                <?php if ($tabName === 'details') : ?><i class="fa-solid fa-chevron-down oasis-record-details-icon" aria-hidden="true"></i><?php endif; ?>
              </a>
            </li>
          <?php endforeach; ?>
        </ul>

        <div class="tab-content">
          <?php if (!$this->loadInitialTabWithAjax || !isset($activeTabObj) || !$activeTabObj->supportsAjax()) : ?>
            <div id="record-tab-panel-<?= $this->escapeHtmlAttr($this->activeTab) ?>" class="tab-pane <?= $this->escapeHtmlAttr($this->activeTab) ?>-tab">
              <?= isset($activeTabObj) ? $this->record($this->driver)->getTab($activeTabObj) : '' ?>
            </div>
          <?php endif; ?>
        </div>
      </div>
    <?php endif; ?>
    <?php $this->layout()->oasisRecordTabs = ob_get_clean(); ?>

    <?= $this->record($this->driver)->getCoreMetadata() ?>

    <?= $this->driver->supportsCoinsOpenURL() ? '<span class="Z3988" title="' . $this->escapeHtmlAttr($this->driver->getCoinsOpenURL()) . '"></span>' : '' ?>
  </div>
</div>
<?= $this->inlineScript(\Laminas\View\Helper\HeadScript::SCRIPT, '$(document).ready(recordDocReady);', 'SET'); ?>
