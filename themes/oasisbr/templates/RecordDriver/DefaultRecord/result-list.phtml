              <a href="<?= ($containerID ? $this->recordLinker()->getUrl("$containerSource|$containerID") : $this->record($this->driver)->getLink('journaltitle', str_replace(['{{{{START_HILITE}}}}', '{{{{END_HILITE}}}}'], '', $journalTitle))) ?>"><?= $this->highlight($journalTitle) ?></a>
