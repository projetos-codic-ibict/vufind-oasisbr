<?php
/**
 * Oasisbr search result card.
 *
 * Keep all data retrieval on the already-loaded record driver: result cards
 * must not issue individual requests for metadata or full-text links.
 */
$driver = $this->driver;
$record = $this->record($driver);
$recordLinker = $this->recordLinker($this->results);
$recordUrl = $recordLinker->getUrl($driver);
$titleText = $driver->getTitle();

$formats = $driver->getFormats();
$format = $formats[0] ?? '';
$publicationDates = $driver->getPublicationDates();
$publicationDate = $publicationDates[0] ?? '';

$authors = array_values(array_unique(array_merge(
    $driver->getPrimaryAuthors(),
    $driver->getSecondaryAuthors(),
    $driver->getCorporateAuthors()
)));

$source = $driver->getContainerTitle();
if (empty($source)) {
    $source = $driver->tryMethod('getSource') ?: '';
}
$institution = $driver->tryMethod('getInstitution') ?: '';
if (empty($institution)) {
    $institutions = $driver->getInstitutions();
    $institution = $institutions[0] ?? '';
}

$summaries = $driver->getSummary();
$summary = trim(preg_replace('/\s+/u', ' ', strip_tags($summaries[0] ?? '')));
$excerptLength = 360;
if (mb_strlen($summary) > $excerptLength) {
    $excerpt = mb_substr($summary, 0, $excerptLength);
    $lastSpace = mb_strrpos($excerpt, ' ');
    $summary = rtrim($lastSpace === false ? $excerpt : mb_substr($excerpt, 0, $lastSpace)) . '…';
}

// The Oasisbr rights field is the available per-record confirmation of OA.
$rights = (string)($driver->tryMethod('getRights') ?: '');
$isOpenAccess = $rights !== '' && preg_match(
    '/(?:open[\s-]?access|acesso[\s-]?aberto|info:eu-repo\/semantics\/openaccess)/iu',
    $rights
);

$openUrl = $this->openUrl($driver, 'results');
$links = $record->getLinkDetails($openUrl->isActive());
$fullTextLinks = array_values(array_filter(
    is_array($links) ? $links : [],
    static fn ($link) => !empty($link['url']) && filter_var($link['url'], FILTER_VALIDATE_URL)
));
$hasCitations = count($driver->getCitationFormats()) > 0;
$canSave = $this->userlist()->getMode() !== 'disabled'
    && $this->permission()->allowDisplay('feature.Favorites');
$saveAlternateContent = !$canSave && $this->userlist()->getMode() !== 'disabled'
    ? $this->permission()->getAlternateContent('feature.Favorites')
    : null;
?>
<input type="hidden" value="<?= $this->escapeHtmlAttr($driver->getUniqueID()) ?>" class="hiddenId" />
<input type="hidden" value="<?= $this->escapeHtmlAttr($driver->getSourceIdentifier()) ?>" class="hiddenSource" />
<article class="oasis-result-card">
  <header class="oasis-result-card__header">
    <div class="oasis-result-card__badges">
      <?php if ($format !== ''): ?>
        <span class="oasis-result-card__format"><?= $this->transEsc($format) ?></span>
      <?php endif; ?>
      <?php if ($isOpenAccess): ?>
        <span class="oasis-result-card__access"><?= $this->transEsc('openAccess') ?></span>
      <?php endif; ?>
      <?php if ($publicationDate !== ''): ?>
        <span class="oasis-result-card__year"><?= $this->escapeHtml($publicationDate) ?></span>
      <?php endif; ?>
    </div>
    <h2 class="oasis-result-card__title">
      <a href="<?= $this->escapeHtmlAttr($recordUrl) ?>" class="title getFull" data-view="<?= isset($this->params) ? $this->params->getOptions()->getListViewOption() : 'list' ?>">
        <?= $record->getTitleHtml() ?>
      </a>
    </h2>
  </header>

  <?php if (!empty($authors) && !$driver->isCollection()): ?>
    <p class="oasis-result-card__authors">
      <?php foreach ($authors as $index => $author): ?>
        <a href="<?= $record->getLink('author', $this->highlight($author, null, true, false)) ?>"><?= $this->highlight(rtrim($author, ',')) ?></a><?= $index + 1 < count($authors) ? '; ' : '' ?>
      <?php endforeach; ?>
    </p>
  <?php endif; ?>

  <?php if ($source !== '' || $institution !== ''): ?>
    <p class="oasis-result-card__source">
      <?php if ($source !== ''): ?><span><?= $this->escapeHtml($source) ?></span><?php endif; ?>
      <?php if ($source !== '' && $institution !== ''): ?><span aria-hidden="true"> · </span><?php endif; ?>
      <?php if ($institution !== ''): ?><span><?= $this->escapeHtml($institution) ?></span><?php endif; ?>
    </p>
  <?php endif; ?>

  <?php if ($summary !== ''): ?>
    <p class="oasis-result-card__summary"><?= $this->escapeHtml($summary) ?></p>
  <?php endif; ?>

  <?php if (!empty($fullTextLinks) || $hasCitations || $canSave || $saveAlternateContent): ?>
    <div class="oasis-result-card__actions hidden-print">
      <?php foreach ($fullTextLinks as $index => $link): ?>
        <a class="oasis-result-card__fulltext" href="<?= $this->escapeHtmlAttr($this->proxyUrl($link['url'])) ?>" target="_blank" rel="noopener noreferrer" aria-label="<?= $this->transEscAttr('result_full_text_source_for', ['%%title%%' => $titleText]) ?>">
          <span><?= $this->transEsc('result_full_text_source') ?><?= count($fullTextLinks) > 1 ? ' (' . ($index + 1) . ')' : '' ?></span>
          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
          <span class="visually-hidden"><?= $this->transEsc('opens new tab') ?></span>
        </a>
      <?php endforeach; ?>
      <?php if ($hasCitations): ?>
        <a class="oasis-result-card__cite" data-lightbox href="<?= $this->escapeHtmlAttr($recordLinker->getActionUrl($driver, 'Cite')) ?>" rel="nofollow" aria-label="<?= $this->transEscAttr('result_cite_for', ['%%title%%' => $titleText]) ?>">
          <?= $this->transEsc('result_cite') ?>
        </a>
      <?php endif; ?>
      <?php if ($canSave): ?>
        <a class="oasis-result-card__save save-record" data-lightbox href="<?= $this->escapeHtmlAttr($recordLinker->getActionUrl($driver, 'Save')) ?>" data-id="<?= $this->escapeHtmlAttr($driver->getUniqueId()) ?>" aria-label="<?= $this->transEscAttr('Save') ?>: <?= $this->escapeHtmlAttr($titleText) ?>">
          <?= $this->transEsc('Save') ?>
        </a>
      <?php elseif ($saveAlternateContent): ?>
        <?= $saveAlternateContent ?>
      <?php endif; ?>
    </div>
  <?php endif; ?>
</article>
